-- test that bytea key column in hash is rejected
create foreign table db15_bytea_hash_bad(key bytea, val text)
       server localredis
       options (singleton_key 'bytea_hash_bad', tabletype 'hash', database '15');
insert into db15_bytea_hash_bad values (E'key'::bytea, 'val');
ERROR:  bytea not supported for hash field column
-- A hash row is written with one variadic HSET rather than one HSET per
-- field, so every field/value pair of the row has to arrive, paired as it was
-- given. A small hash is a listpack, which HGETALL returns in insertion
-- order, so the array comes back in the order it went in -- the same
-- assumption the non-singleton hash tests above already make.
create foreign table db15_ins_hash(key text, val text[])
       server localredis
       options (database '15', tabletype 'hash', tablekeyprefix 'insh_');
insert into db15_ins_hash values ('insh_1', '{f1,v1,f2,v2,f3,v3}');
select key, val from db15_ins_hash where key = 'insh_1';
  key   |         val         
--------+---------------------
 insh_1 | {f1,v1,f2,v2,f3,v3}
(1 row)

-- a key that is already there is refused, and its fields are untouched
insert into db15_ins_hash values ('insh_1', '{f4,v4}');
ERROR:  key already exists: insh_1
select key, val from db15_ins_hash where key = 'insh_1';
  key   |         val         
--------+---------------------
 insh_1 | {f1,v1,f2,v2,f3,v3}
(1 row)

delete from db15_ins_hash;
select * from db15_ins_hash;
 key | val 
-----+-----
(0 rows)

drop foreign table db15_ins_hash;
-- A key column of a type other than text is converted with that type's input
-- function on every scan path, including the heap_form_tuple one an array
-- value column takes. That path built column 0 with CStringGetTextDatum()
-- whatever the column's declared type, so an integer key column read the text
-- datum's pointer as its value: issue #65 saw 569145120 on one run and
-- 2103024504 on the next. The number is an address and so varies per run,
-- which is why nothing below names one. Each key is stored as its own value
-- instead, so the assertion is that the two agree, and a failure prints
-- whatever pointer turned up. A hash table is the shape the issue reported.
\! redis-cli -n 15 hset 10001 k 10001 > /dev/null
\! redis-cli -n 15 hset 10002 k 10002 > /dev/null
\! redis-cli -n 15 sadd ikeys 10001 10002 > /dev/null
create foreign table db15_intkey(key integer, value text[])
       server localredis
       options (database '15', tabletype 'hash', tablekeyset 'ikeys');
-- read in full. count(distinct key), not count(*), per test/README.md
select count(distinct key) as keys,
       count(distinct key) filter (where value = array['k', key::text])
           as keys_matching_their_value
from db15_intkey;
 keys | keys_matching_their_value 
------+---------------------------
    2 |                         2
(1 row)

-- and by key, which the pointer also broke: the qual is pushed down as the
-- key's text, the row comes back, and then the recheck compares 10002 with
-- whatever the pointer happened to be
select key, value from db15_intkey where key = 10001;
  key  |   value   
-------+-----------
 10001 | {k,10001}
(1 row)

select key, value from db15_intkey where key = 10002;
  key  |   value   
-------+-----------
 10002 | {k,10002}
(1 row)

drop foreign table db15_intkey;
-- A text-like key column carrying a typmod -- varchar(n), char(n) -- goes
-- through the input function for the same reason, since CStringGetTextDatum()
-- ignores the typmod: an over-long varchar(n) key used to be stored as it
-- stood on this path while the BuildTupleFromCStrings path beside it refused
-- it, and a char(n) key came back unpadded. Pre-existing, and the same single
-- dispatch covers it.
create foreign table db15_vckey(key varchar(3), value text[])
       server localredis
       options (database '15', tabletype 'hash', tablekeyset 'ikeys');
select * from db15_vckey; -- error: the keys are five characters
ERROR:  value too long for type character varying(3)
drop foreign table db15_vckey;
\! redis-cli -n 15 del 10001 10002 ikeys > /dev/null
\i test/common/epilogue.sql
-- Shared epilogue for every redis_fdw test module: assert that the module left
-- db 15 empty, so the next module starts from nothing and any module can run on
-- its own.
--
-- This asserts rather than flushes. A flush would make the assertion true by
-- destroying the evidence a failing module left behind. Every key printed below
-- is a line that is not in the expected file, so the module that leaked is the
-- first to fail and names the key, instead of the cause being buried in a
-- refusal from whatever runs next. KEYS, like the prologue's DBSIZE, sees keys
-- of every type. LC_ALL so a leak of several keys reads the same on every
-- machine; the passing output is empty either way. See test/README.md.
\! redis-cli -n 15 keys '*' | LC_ALL=C sort

set client_min_messages = warning;
drop server localredis cascade;
reset client_min_messages;
