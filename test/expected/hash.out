  key  |    val    
-------+-----------
 c_whk | {f,g,h,i}
 e_whk | {j,k}
(2 rows)

update db15_w_hash_kset set key = 'x_whk', val = '{w,x,y,z}' where key = 'c_whk';
select key, val from db15_w_hash_kset order by key;
  key  |    val    
-------+-----------
 e_whk | {j,k}
 x_whk | {w,x,y,z}
(2 rows)

update db15_w_hash_kset set key = 'z_whk' where key = 'x_whk';
select key, val from db15_w_hash_kset order by key;
